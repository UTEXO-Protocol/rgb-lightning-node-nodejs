+            Uuid::new_v4(),
+        )
+        .expect("other store");
+        other_installation
+            .acquire_fence()
+            .expect_err("a different installation must remain fenced out");
+
+        restarted
+            .release_fence_if_owned()
+            .expect("test cleanup releases fence");
+    }
