+
+impl From<JsonWalletSyncMode> for WalletSyncMode {
+    fn from(mode: JsonWalletSyncMode) -> Self {
+        match mode {
+            JsonWalletSyncMode::Routine => WalletSyncMode::Routine,
+            JsonWalletSyncMode::Recovery => WalletSyncMode::Recovery,
+        }
+    }
+}
+
+impl From<WalletSyncMode> for JsonWalletSyncMode {
+    fn from(mode: WalletSyncMode) -> Self {
+        match mode {
