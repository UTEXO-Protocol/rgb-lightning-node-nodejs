+            writer_id,
+        )
+        .expect("restarted store");
+        restarted
+            .acquire_fence()
+            .expect("same installation reclaims its fence");
+
+        let other_installation = VssKvStore::new_with_retry_and_instance_id(
+            VSS_URL.to_string(),
+            store_id,
+            signing_key,
