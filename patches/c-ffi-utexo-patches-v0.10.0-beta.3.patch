+pub(crate) async fn list_address_receipts(
+    state: Arc<AppState>,
+    address: String,
+) -> Result<Vec<AddressReceiptData>, APIError> {
+    let network: bitcoin::Network = state.static_state.network.into();
+    let address = bitcoin::Address::from_str(&address)
+        .map_err(|e| APIError::InvalidRequest(format!("invalid Bitcoin address: {e}")))?
+        .require_network(network)
+        .map_err(|e| APIError::InvalidRequest(format!("Bitcoin address network mismatch: {e}")))?;
+    let guard = check_unlocked(&state).await?;
+    let unlocked_state = guard.as_ref().unwrap();
+    Ok(unlocked_state
+        .address_indexer
+        .list_address_receipts(&address)
+        .map_err(APIError::Network)?
+        .into_iter()
+        .map(|receipt| AddressReceiptData {
+            txid: receipt.txid.to_string(),
+            amount_sat: receipt.amount_sat,
+            confirmations: receipt.confirmations,
+            block_height: receipt.block_height,
+        })
+        .collect())
+}
