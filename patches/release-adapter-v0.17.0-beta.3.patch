+    #[test]
+    fn output_journal_transition_excludes_an_already_waiting_snapshot() {
+        use std::io::{Cursor, Read};
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        let wrapper = Arc::new(signetcustom_wallet_source());
+        let directory = wrapper.get_rgb_wallet().get_wallet_dir();
+        let fingerprint = directory.file_name().unwrap().to_str().unwrap().to_owned();
+        let journal = directory.join("rln_output_operations_v1");
+        std::fs::create_dir_all(&journal).unwrap();
+        let journal_file = journal.join("coherence-fixture.json");
+        let (partial_tx, partial_rx) = mpsc::channel();
+        let (finish_tx, finish_rx) = mpsc::channel();
+        let (attempt_tx, attempt_rx) = mpsc::channel();
+        let (captured_tx, captured_rx) = mpsc::channel();
+
+        std::thread::scope(|scope| {
+            let writer_wrapper = Arc::clone(&wrapper);
+            let writer_file = journal_file.clone();
+            let writer = scope.spawn(move || {
+                writer_wrapper.with_output_operation_snapshot(|| {
+                    // Simulate a real DB mutation followed by an interrupted journal write.
+                    writer_wrapper.get_rgb_wallet().get_address().unwrap();
+                    std::fs::write(&writer_file, br#"{"status":"preparing"}"#).unwrap();
+                    partial_tx.send(()).unwrap();
+                    finish_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+                    std::fs::write(&writer_file, br#"{"status":"prepared","psbt":"exact"}"#)
+                        .unwrap();
+                    Ok(())
+                })
+            });
+            partial_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+            let backup_wrapper = Arc::clone(&wrapper);
+            let backup = scope.spawn(move || {
+                attempt_tx.send(()).unwrap();
+                // This is the same admission used by manual backup and policy catch-up.
+                let snapshot = backup_wrapper
+                    .get_rgb_wallet_for_snapshot()
+                    .prepare_snapshot()
+                    .unwrap();
+                captured_tx.send(()).unwrap();
+                snapshot
+            });
+            attempt_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+            assert_eq!(
+                captured_rx.recv_timeout(Duration::from_millis(100)),
+                Err(mpsc::RecvTimeoutError::Timeout),
+                "snapshot captured a DB/journal transition before the prepared record"
+            );
+            finish_tx.send(()).unwrap();
+            writer.join().unwrap().unwrap();
+            let snapshot = backup.join().unwrap();
+            let mut archive = zip::ZipArchive::new(Cursor::new(snapshot.data)).unwrap();
+            let mut saved = String::new();
+            archive
+                .by_name(&format!(
+                    "{fingerprint}/rln_output_operations_v1/coherence-fixture.json"
+                ))
+                .unwrap()
+                .read_to_string(&mut saved)
+                .unwrap();
+            assert_eq!(saved, r#"{"status":"prepared","psbt":"exact"}"#);
+        });
+    }
