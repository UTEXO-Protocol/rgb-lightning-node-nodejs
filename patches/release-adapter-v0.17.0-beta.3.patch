@@ -0,0 +1,1185 @@
+//! Maintained-binding BIP-322 simple implementation. No RPC, PSBT input or broadcast path.
+//! Supports P2TR key-path and compressed-key P2WPKH verification only.
+use base64::{engine::general_purpose::STANDARD, Engine};
+use bitcoin::{
+    absolute,
+    address::NetworkUnchecked,
+    bip32::{ChildNumber, Xpriv, Xpub},
+    consensus::serialize,
+    hashes::{sha256, Hash},
+    key::TapTweak,
+    opcodes::all::OP_RETURN,
+    script::Builder,
+    secp256k1::{self, Keypair, Message, Secp256k1, SecretKey, XOnlyPublicKey},
+    sighash::{Prevouts, SighashCache},
+    transaction, Address, Amount, EcdsaSighashType, Network, OutPoint, ScriptBuf, Sequence,
+    TapSighashType, Transaction, TxIn, TxOut, Witness,
+};
+use rand::RngCore;
+use std::str::FromStr;
+
+pub const MAX_MESSAGE_BYTES: usize = 4096;
+pub const MAX_SIGNATURE_CHARS: usize = 4096;
+
+fn invalid() -> String {
+    "invalid BIP-322 request or unsupported signature".to_owned()
+}
+pub fn validate_message(message: &str) -> Result<(), String> {
+    if message.len() > MAX_MESSAGE_BYTES {
+        return Err(invalid());
+    }
+    Ok(())
+}
+pub fn parse_address(value: &str, network: Network) -> Result<Address, String> {
+    if value.len() > 128 || value.bytes().any(|b| !b.is_ascii_graphic()) {
+        return Err(invalid());
+    }
+    Address::<NetworkUnchecked>::from_str(value)
+        .map_err(|_| invalid())?
+        .require_network(network)
+        .map_err(|_| invalid())
+}
+
+pub fn message_hash(message: &str) -> sha256::Hash {
+    let tag = sha256::Hash::hash(b"BIP0322-signed-message");
+    let mut bytes = Vec::with_capacity(64 + message.len());
+    bytes.extend_from_slice(tag.as_byte_array());
+    bytes.extend_from_slice(tag.as_byte_array());
+    bytes.extend_from_slice(message.as_bytes());
+    sha256::Hash::hash(&bytes)
+}
+
+pub fn virtual_transactions(message: &str, address: &Address) -> (Transaction, Transaction) {
+    let challenge = TxOut {
+        value: Amount::ZERO,
+        script_pubkey: address.script_pubkey(),
+    };
+    let to_spend = Transaction {
+        version: transaction::Version(0),
+        lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn {
+            previous_output: OutPoint::null(),
+            script_sig: Builder::new()
+                .push_int(0)
+                .push_slice(message_hash(message).to_byte_array())
+                .into_script(),
+            sequence: Sequence::ZERO,
+            witness: Witness::new(),
+        }],
+        output: vec![challenge],
+    };
+    let to_sign = Transaction {
+        version: transaction::Version(0),
+        lock_time: absolute::LockTime::ZERO,
+        input: vec![TxIn {
+            previous_output: OutPoint {
+                txid: to_spend.compute_txid(),
+                vout: 0,
+            },
+            script_sig: ScriptBuf::new(),
+            sequence: Sequence::ZERO,
+            witness: Witness::new(),
+        }],
+        output: vec![TxOut {
+            value: Amount::ZERO,
+            script_pubkey: Builder::new().push_opcode(OP_RETURN).into_script(),
+        }],
+    };
+    (to_spend, to_sign)
+}
+
+/// Only the first vanilla receive key is retained, never the master seed/account xpriv.
+/// Its account xpub must match the actual signer's bootstrap before use.
+pub struct MessageKey {
+    secret: SecretKey,
+    pub account_xpub: String,
+    pub address: Address,
+    pub network: Network,
+}
+impl Drop for MessageKey {
+    fn drop(&mut self) {
+        self.secret.non_secure_erase();
+    }
+}
+impl MessageKey {
+    pub fn from_seed(seed: &[u8; 32], network: Network) -> Result<Self, String> {
+        let secp = Secp256k1::new();
+        let mut master = Xpriv::new_master(network, seed).map_err(|_| invalid())?;
+        let path = [
+            ChildNumber::from_hardened_idx(86).unwrap(),
+            ChildNumber::from_hardened_idx(if network == Network::Bitcoin { 0 } else { 1 })
+                .unwrap(),
+            ChildNumber::from_hardened_idx(0).unwrap(),
+        ];
+        let derived = master.derive_priv(&secp, &path);
+        master.private_key.non_secure_erase();
+        let mut account = derived.map_err(|_| invalid())?;
+        let account_xpub = Xpub::from_priv(&secp, &account).to_string();
+        let derived = account.derive_priv(
+            &secp,
+            &[
+                ChildNumber::Normal { index: 0 },
+                ChildNumber::Normal { index: 0 },
+            ],
+        );
+        account.private_key.non_secure_erase();
+        let mut child = derived.map_err(|_| invalid())?;
+        let secret = child.private_key;
+        child.private_key.non_secure_erase();
+        let mut pair = Keypair::from_secret_key(&secp, &secret);
+        let (internal_key, _) = pair.x_only_public_key();
+        pair.non_secure_erase();
+        let address = Address::p2tr(&secp, internal_key, None, network);
+        Ok(Self {
+            secret,
+            account_xpub,
+            address,
+            network,
+        })
+    }
+    pub fn sign(&self, message: &str, requested_address: &str) -> Result<String, String> {
+        validate_message(message)?;
+        let address = parse_address(requested_address, self.network)?;
+        if address.script_pubkey() != self.address.script_pubkey() {
+            return Err("BIP-322 address is not the wallet signing address".to_owned());
+        }
+        let (to_spend, to_sign) = virtual_transactions(message, &address);
+        let sighash = SighashCache::new(&to_sign)
+            .taproot_key_spend_signature_hash(
+                0,
+                &Prevouts::All(&to_spend.output),
+                TapSighashType::Default,
+            )
+            .map_err(|_| invalid())?;
+        let secp = Secp256k1::new();
+        // Obtain entropy before creating temporary private keypair copies so errors cannot skip erasure.
+        let mut auxiliary = [0u8; 32];
+        rand::rngs::OsRng
+            .try_fill_bytes(&mut auxiliary)
+            .map_err(|_| "BIP-322 secure randomness is unavailable".to_owned())?;
+        let mut pair = Keypair::from_secret_key(&secp, &self.secret);
+        let mut tweaked = pair.tap_tweak(&secp, None).to_keypair();
+        pair.non_secure_erase();
+        let signature = secp.sign_schnorr_with_aux_rand(
+            &Message::from_digest(sighash.to_byte_array()),
+            &tweaked,
+            &auxiliary,
+        );
+        tweaked.non_secure_erase();
+        let witness = Witness::from_slice(&[signature.as_ref()]);
+        Ok(format!("smp{}", STANDARD.encode(serialize(&witness))))
+    }
+}
+
+pub fn verify(
+    message: &str,
+    address: &str,
+    signature: &str,
+    network: Network,
+) -> Result<bool, String> {
+    validate_message(message)?;
+    let address = parse_address(address, network)?;
+    if signature.len() > MAX_SIGNATURE_CHARS || !signature.is_ascii() {
+        return Err(invalid());
+    }
+    // Historical pre-finalization simple signatures are accepted, but never emitted.
+    let encoded = signature.strip_prefix("smp").unwrap_or(signature);
+    let raw = match STANDARD.decode(encoded) {
+        Ok(raw) => raw,
+        Err(_) => return Ok(false),
+    };
+    if STANDARD.encode(&raw) != encoded || raw.len() > 256 {
+        return Ok(false);
+    }
+    // Our supported scripts require 1 or 2 items, each below 74 bytes: all CompactSize
+    // fields must therefore be a single byte. Bound every field before allocating.
+    let count = match raw.first() {
+        Some(1) => 1,
+        Some(2) => 2,
+        _ => return Ok(false),
+    };
+    let mut offset = 1;
+    let mut items = Vec::with_capacity(count);
+    for _ in 0..count {
+        let len = match raw.get(offset) {
+            Some(n) if *n <= 73 => *n as usize,
+            _ => return Ok(false),
+        };
+        offset += 1;
+        let end = offset + len;
+        if end > raw.len() {
+            return Ok(false);
+        }
+        items.push(&raw[offset..end]);
+        offset = end;
+    }
+    if offset != raw.len() {
+        return Ok(false);
+    }
+    let witness = Witness::from_slice(&items);
+    if serialize(&witness) != raw {
+        return Ok(false);
+    }
+    let script = address.script_pubkey();
+    let (to_spend, to_sign) = virtual_transactions(message, &address);
+    let secp = Secp256k1::verification_only();
+    if script.is_p2tr() {
+        if witness.len() != 1 {
+            return Ok(false);
+        }
+        let item = witness.iter().next().unwrap();
+        let sighash_type = match item.len() {
+            64 => TapSighashType::Default,
+            65 if item[64] == 1 => TapSighashType::All,
+            _ => return Ok(false),
+        };
+        let sig = match secp256k1::schnorr::Signature::from_slice(&item[..64]) {
+            Ok(s) => s,
+            Err(_) => return Ok(false),
+        };
+        let key = XOnlyPublicKey::from_slice(&script.as_bytes()[2..]).map_err(|_| invalid())?;
+        let hash = SighashCache::new(&to_sign)
+            .taproot_key_spend_signature_hash(0, &Prevouts::All(&to_spend.output), sighash_type)
+            .map_err(|_| invalid())?;
+        return Ok(secp
+            .verify_schnorr(&sig, &Message::from_digest(hash.to_byte_array()), &key)
+            .is_ok());
+    }
+    if script.is_p2wpkh() {
+        if witness.len() != 2 {
+            return Ok(false);
+        }
+        let items: Vec<&[u8]> = witness.iter().collect();
+        let signed = items[0];
+        let public = items[1];
+        if signed.len() < 9
+            || signed.len() > 73
+            || signed.last() != Some(&1)
+            || public.len() != 33
+            || !matches!(public[0], 2 | 3)
+        {
+            return Ok(false);
+        }
+        let key = match bitcoin::PublicKey::from_slice(public) {
+            Ok(k) => k,
+            Err(_) => return Ok(false),
+        };
+        if Address::p2wpkh(&bitcoin::CompressedPublicKey(key.inner), network).script_pubkey()
+            != script
+        {
+            return Ok(false);
+        }
+        let sig = match secp256k1::ecdsa::Signature::from_der(&signed[..signed.len() - 1]) {
+            Ok(s) => s,
+            Err(_) => return Ok(false),
+        };
+        let mut normalized = sig;
+        normalized.normalize_s();
+        if normalized != sig || sig.serialize_der().as_ref() != &signed[..signed.len() - 1] {
+            return Ok(false);
+        }
+        let hash = SighashCache::new(&to_sign)
+            .p2wpkh_signature_hash(0, &script, Amount::ZERO, EcdsaSighashType::All)
+            .map_err(|_| invalid())?;
+        return Ok(secp
+            .verify_ecdsa(
+                &Message::from_digest(hash.to_byte_array()),
+                &sig,
+                &key.inner,
+            )
+            .is_ok());
+    }
+    Err("unsupported BIP-322 address type; requires P2TR key-path or P2WPKH".to_owned())
+}
