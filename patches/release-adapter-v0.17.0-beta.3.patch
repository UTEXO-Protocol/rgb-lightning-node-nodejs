+/// Owns every session worker, including work created by events and peer connections.
+/// Closing admission and taking the handles use the same mutex as spawning, so shutdown
+/// cannot miss a worker registered concurrently with it. Workers must finish in-flight
+/// persistence/chain operations before observing cancellation at their next wait.
+pub(crate) struct SessionTasks {
+    shutdown: CancellationToken,
+    registry: Mutex<SessionTaskRegistry>,
+}
+
+struct SessionTaskRegistry {
+    closed: bool,
+    handles: Vec<JoinHandle<()>>,
+    failures: Vec<String>,
+}
+
+impl SessionTasks {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            shutdown: CancellationToken::new(),
+            registry: Mutex::new(SessionTaskRegistry {
+                closed: false,
+                handles: Vec::new(),
+                failures: Vec::new(),
+            }),
+        })
+    }
+
+    pub(crate) fn cancellation(&self) -> CancellationToken {
+        self.shutdown.clone()
+    }
+
+    pub(crate) fn spawn<F>(&self, future: F) -> Result<(), F>
+    where
+        F: std::future::Future<Output = ()> + Send + 'static,
+    {
+        let mut registry = self.registry.lock().unwrap();
+        if registry.closed {
+            return Err(future);
+        }
+        // Reap completed handles without discarding a task panic. Keeping every completed
+        // connection handle would grow memory for a long-lived routing node.
+        let mut pending = Vec::new();
+        for mut handle in std::mem::take(&mut registry.handles) {
+            if handle.is_finished() {
+                match futures::FutureExt::now_or_never(&mut handle) {
+                    Some(Ok(())) => {}
+                    Some(Err(error)) => registry.failures.push(error.to_string()),
+                    None => pending.push(handle),
+                }
+            } else {
+                pending.push(handle);
+            }
+        }
+        registry.handles = pending;
+        registry.handles.push(tokio::spawn(future));
+        Ok(())
+    }
+
+    fn record_failure(&self, failure: String) {
+        self.registry.lock().unwrap().failures.push(failure);
+    }
+
+    fn close(&self) {
+        self.registry.lock().unwrap().closed = true;
+        self.shutdown.cancel();
+    }
+
+    async fn join(&self) -> Result<(), String> {
+        self.close();
+        let (handles, mut failures) = {
+            let mut registry = self.registry.lock().unwrap();
+            (
+                std::mem::take(&mut registry.handles),
+                std::mem::take(&mut registry.failures),
+            )
+        };
+        for handle in handles {
+            if let Err(error) = handle.await {
+                tracing::error!(%error, "session worker failed while shutting down");
+                failures.push(error.to_string());
+            }
+        }
+        // A live worker can report an I/O failure while we await its handle. Admission
+        // is closed and every owned task is now done, so this final reap is complete.
+        failures.extend(std::mem::take(&mut self.registry.lock().unwrap().failures));
+        if failures.is_empty() {
+            Ok(())
+        } else {
+            Err(failures.join("; "))
+        }
+    }
+}
+
+impl Drop for SessionTasks {
+    fn drop(&mut self) {
+        self.shutdown.cancel();
+        // Rollback for a failed/aborted startup or an owner unwinding unexpectedly.
+        // Normal shutdown awaits these workers, rather than detaching or aborting them.
+        let registry = self
+            .registry
+            .get_mut()
+            .unwrap_or_else(|error| error.into_inner());
+        for handle in registry.handles.drain(..) {
+            handle.abort();
+        }
+    }
+}
