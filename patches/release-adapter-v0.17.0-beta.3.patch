+/// Exercise the real SDK policy switch against the actual encrypted protobuf client.
+/// Temporary suspension never turns a local content acknowledgement into cloud completion.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn automatic_snapshot_policy_pauses_and_acknowledges_only_confirmed_cloud_commit() {
+    let server = Server::new().await;
+    let wallet = Wallet::new(&server).await;
+    sdk::unlock(wallet.state.clone(), wallet.request())
+        .await
+        .unwrap();
+    let wrapper = wallet
+        .state
+        .unlocked_app_state
+        .lock()
+        .await
+        .as_ref()
+        .unwrap()
+        .rgb_wallet_wrapper
+        .clone();
+    let policy = wrapper.snapshot_policy.as_ref().unwrap().clone();
+    let rgb_store = format!("{}_rgb", store_id());
+    sdk::address(wallet.state.clone()).await.unwrap();
+    let initial: Value = serde_json::from_str(&policy.metadata().unwrap()).unwrap();
+    assert_eq!(initial["automatic_backup_enabled"], true);
+    assert!(initial["last_backup"]["completed_at_ms"].as_u64().unwrap() > 0);
+    assert!(!policy.pending());
+    let first = server.rows(&rgb_store)["backup/manifest"].version;
+    sdk::set_vss_automatic_backup_enabled(wallet.state.clone(), false)
+        .await
+        .unwrap();
+    sdk::rotate_address(wallet.state.clone()).await.unwrap();
+    assert!(policy.pending());
+    assert!(!policy.enabled.load(std::sync::atomic::Ordering::SeqCst));
+    assert_eq!(server.rows(&rgb_store)["backup/manifest"].version, first);
+    let paused: Value = serde_json::from_str(&policy.metadata().unwrap()).unwrap();
+    assert_eq!(paused["last_backup"], initial["last_backup"]);
+    let gate = Arc::new(BackupGate {
+        store: rgb_store.clone(),
+        entered: Semaphore::new(0),
+        resume: Semaphore::new(0),
+    });
+    server.state.lock().unwrap().backup_gate = Some(gate.clone());
+    let state = wallet.state.clone();
+    let enabling =
+        tokio::spawn(async move { sdk::set_vss_automatic_backup_enabled(state, true).await });
+    tokio::time::timeout(std::time::Duration::from_secs(10), gate.entered.acquire())
+        .await
+        .unwrap()
+        .unwrap()
+        .forget();
+    assert!(
+        policy.pending(),
+        "inflight cloud write cleared pending before confirmation"
+    );
+    assert!(
+        !policy.enabled.load(std::sync::atomic::Ordering::SeqCst),
+        "switch acknowledged before catch-up commit"
+    );
+    assert_eq!(
+        serde_json::from_str::<Value>(&policy.metadata().unwrap()).unwrap()["last_backup"],
+        initial["last_backup"]
+    );
+    // A canceled UI waiter cannot cancel the admitted policy catch-up or reopen its writer.
+    enabling.abort();
+    assert!(enabling.await.unwrap_err().is_cancelled());
+    gate.resume.add_permits(1);
+    let until = tokio::time::Instant::now() + std::time::Duration::from_secs(10);
+    while !policy.enabled.load(std::sync::atomic::Ordering::SeqCst) {
+        assert!(
+            tokio::time::Instant::now() < until,
+            "policy catch-up did not complete"
+        );
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+    assert!(!policy.pending());
+    assert!(!policy.failed.load(std::sync::atomic::Ordering::SeqCst));
+    assert_eq!(
+        server.rows(&rgb_store)["backup/manifest"].version,
+        first + 1
+    );
+    let acknowledged: Value = serde_json::from_str(&policy.metadata().unwrap()).unwrap();
+    assert!(
+        acknowledged["last_backup"]["completed_at_ms"]
+            .as_u64()
+            .unwrap()
+            >= initial["last_backup"]["completed_at_ms"].as_u64().unwrap()
+    );
+    sdk::rotate_address(wallet.state.clone()).await.unwrap();
+    assert!(!policy.pending());
+    assert_eq!(
+        server.rows(&rgb_store)["backup/manifest"].version,
+        first + 2
+    );
+    sdk::set_vss_automatic_backup_enabled(wallet.state.clone(), false)
+        .await
+        .unwrap();
+    wallet.lock().await;
+    sdk::unlock(wallet.state.clone(), wallet.request())
+        .await
+        .unwrap();
+    let reopened: Value = serde_json::from_str(
+        &sdk::vss_backup_metadata(wallet.state.clone())
+            .await
+            .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(reopened["automatic_backup_enabled"], false);
+    wallet.lock().await;
+    assert!(server
+        .state
+        .lock()
+        .unwrap()
+        .requests
+        .iter()
+        .all(|r| r.authenticated));
+}
