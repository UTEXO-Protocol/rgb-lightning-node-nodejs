+}
+pub(crate) fn sign_message_bip322(
+    node: &COpaqueStruct,
+    request_json: *const c_char,
+) -> Result<String, Error> {
+    let req: Bip322SignRequest = parse_bip322_req(request_json)?;
+    json(require_handle(node)?.sign_message_bip322(req.message, req.address)?)
+}
+pub(crate) fn verify_message_bip322(
+    node: &COpaqueStruct,
+    request_json: *const c_char,
+) -> Result<String, Error> {
+    let req: Bip322VerifyRequest = parse_bip322_req(request_json)?;
+    json(require_handle(node)?.verify_message_bip322(req.message, req.address, req.signature)?)
+}
+pub(crate) fn verify_message_bip322_offline(request_json: *const c_char) -> Result<String, Error> {
+    let req: Bip322VerifyOfflineRequest = parse_bip322_req(request_json)?;
+    json(rln::verify_message_bip322(
+        req.message,
+        req.address,
+        req.signature,
+        req.network,
+    )?)
+}
