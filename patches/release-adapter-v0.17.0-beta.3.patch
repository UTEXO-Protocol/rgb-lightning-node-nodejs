+
+fn parse_bip322_req<T: serde::de::DeserializeOwned>(ptr: *const c_char) -> Result<T, Error> {
+    if ptr.is_null() {
+        return Err(Error::StringParse("missing BIP-322 request".into()));
+    }
+    // FFI callers own a valid nul-terminated string. Bound before making a Rust String.
+    let bytes = unsafe { std::ffi::CStr::from_ptr(ptr) }.to_bytes();
+    if bytes.len() > 32768 {
+        return Err(Error::StringParse("BIP-322 request exceeds limit".into()));
+    }
+    Ok(serde_json::from_slice(bytes)?)
+}
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Bip322SignRequest {
+    message: String,
