+            policy.commit_enabled(enabled)?;
+            Ok(serde_json::json!({"automatic_backup_enabled":enabled}).to_string())
+        })
+        .await
+        .map_err(|_| APIError::FailedVssInit("VSS policy task failed".into()))?
