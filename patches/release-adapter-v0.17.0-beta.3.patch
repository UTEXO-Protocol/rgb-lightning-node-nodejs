+        .is_err()
+        {
+            cleanup_errors.push(format!(
+                "session managers retained after teardown (peer={}, channel={})",
+                peer_manager.strong_count(),
+                channel_manager.strong_count()
+            ));
+        }
+    }
+    // A monitor write queued before stop may still finish after the store's stop
+    // signal. Drain every completion before releasing the cross-device fence.
+    #[cfg(feature = "vss")]
+    if let Some((store, teardown)) = pending_fence_release {
+        if cleanup_errors.is_empty() {
+            release_vss_fence(store, teardown).await;
+        } else {
+            tracing::error!("retaining VSS fence because session teardown failed");
+        }
+    }
+
+    if app_state.cancel_token.is_cancelled() {
+        // SQLx returns checked-out SQLite connections through tasks on DB_RUNTIME.
+        // That current-thread runtime is idle between database calls, so dropping
+        // the pool alone can leave its final return task and file descriptor parked.
+        // Drive closure on the owning runtime after every persistence user is done.
+        // A REST lock is nonterminal and must retain its database for the next unlock.
+        let database = app_state.db();
+        match tokio::task::spawn_blocking(move || {
+            crate::runtime::block_on(async move { database.close_by_ref().await })
+        })
+        .await
+        {
+            Ok(Ok(())) => {}
+            Ok(Err(error)) => cleanup_errors.push(format!("database pool close failed: {error}")),
+            Err(error) => cleanup_errors.push(format!("database pool close task failed: {error}")),
+        }
+    }
+
     tracing::info!("Stopped node services");
+    let outcome = if cleanup_errors.is_empty() {
+        Ok(())
+    } else {
+        Err(format!(
+            "session teardown failed: {}",
+            cleanup_errors.join("; ")
+        ))
+    };
+    if app_state.cancel_token.is_cancelled() {
+        *teardown_outcome = Some(outcome.clone());
+    }
+    outcome.map_err(APIError::Unexpected)
 }
 
