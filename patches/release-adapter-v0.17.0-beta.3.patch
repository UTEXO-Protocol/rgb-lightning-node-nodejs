index 0000000..9c1b034
--- /dev/null
+++ b/src/uniffi_api/vss_restore.rs
@@ -0,0 +1,1219 @@
+//! Maintained external-signer RGB restore admission. Uses public transport and
+//! crypto APIs, with bounded extraction and a local, destination-bound receipt.
+use crate::rgb_vss::{VssBackupClient, VssBackupConfig};
+use crate::{error::APIError, signer::read_key_source_file, utils::AppState};
+use bitcoin::hashes::{
+    hmac::{Hmac, HmacEngine},
+    sha256, Hash, HashEngine,
+};
+use rand::RngCore;
+use serde::{Deserialize, Serialize};
+#[cfg(unix)]
+use std::os::{
+    fd::AsRawFd,
+    unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt},
+};
+use std::{
+    collections::HashSet,
+    fs::{self, File, OpenOptions},
+    io::{Cursor, Read, Write},
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+const RECEIPT: &str = ".utexo-vss-restore-v1.json";
+const KEY: &str = ".utexo-vss-restore-key-v1";
+const MAX_COMPRESSED: usize = 128 * 1024 * 1024;
+const MAX_INFLATED: u64 = 512 * 1024 * 1024;
+const MAX_ENTRIES: usize = 25000;
+const MAX_MANIFEST: u64 = 65536;
+const MAX_RECEIPT: u64 = 4096;
+const DATABASE_NAME: &str = "rgb_lib_db";
+const SQLITE_HEADER: &[u8; 16] = b"SQLite format 3\0";
+
+fn error(code: &str) -> APIError {
+    APIError::FailedVssInit(code.to_owned())
+}
+fn digest(bytes: &[u8]) -> String {
+    sha256::Hash::hash(bytes).to_string()
+}
+fn valid_fp(s: &str) -> bool {
+    s.len() == 8
+        && s.bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+
+struct Context {
+    base: PathBuf,
+    network: String,
+    node_id: String,
+    fp: String,
+    vanilla: String,
+    colored: String,
+    endpoint: String,
+    endpoint_hash: String,
+    target_hash: String,
+    signing_key: rgb_lib::bitcoin::secp256k1::SecretKey,
+    store_id: String,
+}
+impl Context {
+    fn new(state: &AppState) -> Result<Self, APIError> {
+        let configured = &state.static_state;
+        let endpoint = configured
+            .vss_url
+            .clone()
+            .ok_or_else(|| error("VSS_RESTORE_NOT_CONFIGURED"))?;
+        let meta = fs::symlink_metadata(&configured.storage_dir_path)
+            .map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+        if !meta.is_dir() || meta.file_type().is_symlink() {
+            return Err(error("VSS_RESTORE_INVALID_TARGET"));
+        }
+        let base = fs::canonicalize(&configured.storage_dir_path)
+            .map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+        let source = read_key_source_file(&base)
+            .map_err(|_| error("VSS_RESTORE_INVALID_IDENTITY"))?
+            .ok_or_else(|| error("VSS_RESTORE_EXTERNAL_SIGNER_REQUIRED"))?;
+        if source.mode != crate::signer::key_source::EXTERNAL_SIGNER_MODE_V1
+            || !valid_fp(&source.master_fingerprint)
+            || source
+                .node_id
+                .parse::<bitcoin::secp256k1::PublicKey>()
+                .is_err()
+            || source
+                .account_xpub_vanilla
+                .parse::<bitcoin::bip32::Xpub>()
+                .is_err()
+            || source
+                .account_xpub_colored
+                .parse::<bitcoin::bip32::Xpub>()
+                .is_err()
+        {
+            return Err(error("VSS_RESTORE_INVALID_IDENTITY"));
+        }
+        let identity = crate::ldk::derive_vss_identity_from_key_source(&source)?;
+        let network = format!("{:?}", configured.network).to_lowercase();
+        let target_hash = digest(
+            base.join(&source.master_fingerprint)
+                .as_os_str()
+                .as_encoded_bytes(),
+        );
+        let endpoint_hash = digest(endpoint.as_bytes());
+        Ok(Self {
+            base,
+            network,
+            node_id: source.node_id,
+            fp: source.master_fingerprint,
+            vanilla: source.account_xpub_vanilla,
+            colored: source.account_xpub_colored,
+            endpoint,
+            endpoint_hash,
+            target_hash,
+            signing_key: identity.signing_key,
+            store_id: format!("{}_rgb", identity.pubkey_hex),
+        })
+    }
+    fn config(&self) -> VssBackupConfig {
+        VssBackupConfig::new(
+            self.endpoint.clone(),
+            self.store_id.clone(),
+            self.signing_key,
+        )
+        .with_encryption(true)
+    }
+    fn result(&self, version: Option<i64>) -> serde_json::Value {
+        serde_json::json!({
+        "restored": version.is_some(), "status": if version.is_some() {"restored"} else {"not_found"},
+        "network": self.network, "node_id": self.node_id, "master_fingerprint": self.fp, "version": version })
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Fields {
+    schema_version: u8,
+    network: String,
+    node_id: String,
+    master_fingerprint: String,
+    version: i64,
+    endpoint_sha256: String,
+    target_sha256: String,
+    manifest_identity_sha256: String,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Receipt {
+    fields: Fields,
+    mac: String,
+}
+fn mac(key: &[u8], fields: &Fields) -> Result<String, APIError> {
+    let bytes = serde_json::to_vec(fields).map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?;
+    let mut engine = HmacEngine::<sha256::Hash>::new(key);
+    engine.input(&bytes);
+    Ok(Hmac::<sha256::Hash>::from_engine(engine).to_string())
+}
+#[derive(Clone, Copy)]
+enum LocalReadPolicy {
+    Private,
+    PublicManifest,
+}
+fn bounded_local_read(
+    path: &Path,
+    maximum: u64,
+    policy: LocalReadPolicy,
+) -> Result<Vec<u8>, APIError> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    let file = options
+        .open(path)
+        .map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?;
+    let meta = file
+        .metadata()
+        .map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?;
+    #[cfg(unix)]
+    {
+        let permissions = meta.mode() & 0o7777;
+        let permitted = match policy {
+            LocalReadPolicy::Private => permissions == 0o600,
+            // rgb-lib atomically rewrites its explicitly non-secret manifest on
+            // every Wallet::new. Under the usual umask 022 it becomes 0644.
+            // Receipt/key files remain strictly private; the manifest still has
+            // to be owned, single-linked, non-writable by others and identity-bound.
+            LocalReadPolicy::PublicManifest => {
+                permissions & 0o400 != 0 && permissions & !0o644 == 0
+            }
+        };
+        if meta.uid() != unsafe { libc::geteuid() } || !permitted || meta.nlink() != 1 {
+            return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+        }
+    }
+    #[cfg(not(unix))]
+    let _ = policy;
+    if !meta.is_file() || meta.len() > maximum {
+        return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+    }
+    let mut bytes = Vec::new();
+    file.take(maximum + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?;
+    if bytes.len() as u64 > maximum {
+        return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+    }
+    Ok(bytes)
+}
+fn private_read(path: &Path, maximum: u64) -> Result<Vec<u8>, APIError> {
+    bounded_local_read(path, maximum, LocalReadPolicy::Private)
+}
+fn public_manifest_read(path: &Path) -> Result<Vec<u8>, APIError> {
+    bounded_local_read(path, MAX_MANIFEST, LocalReadPolicy::PublicManifest)
+}
+fn read_key(ctx: &Context) -> Result<Vec<u8>, APIError> {
+    let key = private_read(&ctx.base.join(KEY), 32)?;
+    if key.len() != 32 {
+        return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+    }
+    Ok(key)
+}
+#[cfg(unix)]
+fn promote(
+    source_parent: &File,
+    source: &str,
+    target_parent: &File,
+    target: &str,
+) -> Result<(), APIError> {
+    let a = std::ffi::CString::new(source).map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+    let b = std::ffi::CString::new(target).map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+    #[cfg(target_vendor = "apple")]
+    let result = unsafe {
+        libc::renameatx_np(
+            source_parent.as_raw_fd(),
+            a.as_ptr(),
+            target_parent.as_raw_fd(),
+            b.as_ptr(),
+            libc::RENAME_EXCL,
+        )
+    };
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_renameat2,
+            source_parent.as_raw_fd(),
+            a.as_ptr(),
+            target_parent.as_raw_fd(),
+            b.as_ptr(),
+            libc::RENAME_NOREPLACE,
+        ) as libc::c_int
+    };
+    #[cfg(not(any(target_vendor = "apple", target_os = "linux", target_os = "android")))]
+    return Err(error("VSS_RESTORE_ATOMIC_PROMOTION_UNAVAILABLE"));
+    if result != 0 {
+        return Err(error("VSS_RESTORE_TARGET_CONFLICT"));
+    }
+    Ok(())
+}
+#[cfg(not(unix))]
+fn promote(_: &File, _: &str, _: &File, _: &str) -> Result<(), APIError> {
+    Err(error("VSS_RESTORE_ATOMIC_PROMOTION_UNAVAILABLE"))
+}
+fn open_directory(path: &Path) -> Result<File, APIError> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW);
+    let file = options
+        .open(path)
+        .map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+    let meta = file
+        .metadata()
+        .map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+    if !meta.is_dir() {
+        return Err(error("VSS_RESTORE_INVALID_TARGET"));
+    }
+    #[cfg(unix)]
+    if meta.uid() != unsafe { libc::geteuid() } {
+        return Err(error("VSS_RESTORE_INVALID_TARGET"));
+    }
+    Ok(file)
+}
+fn receipt_key(ctx: &Context, base: &File) -> Result<Vec<u8>, APIError> {
+    if fs::symlink_metadata(ctx.base.join(KEY)).is_ok() {
+        return read_key(ctx);
+    }
+    let mut temp = tempfile::Builder::new()
+        .prefix(".vss-receipt-key-")
+        .tempfile_in(&ctx.base)
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    let mut key = [0u8; 32];
+    rand::thread_rng().fill_bytes(&mut key);
+    temp.write_all(&key)
+        .and_then(|_| temp.as_file().sync_all())
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    let filename = temp
+        .path()
+        .file_name()
+        .and_then(|v| v.to_str())
+        .ok_or_else(|| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    match promote(base, filename, base, KEY) {
+        Ok(()) => {}
+        Err(_) if fs::symlink_metadata(ctx.base.join(KEY)).is_ok() => return read_key(ctx),
+        Err(e) => return Err(e),
+    }
+    base.sync_all()
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    Ok(key.to_vec())
+}
+fn manifest_identity(bytes: &[u8], ctx: &Context) -> Result<String, APIError> {
+    let value: serde_json::Value =
+        serde_json::from_slice(bytes).map_err(|_| error("VSS_RESTORE_INVALID_MANIFEST"))?;
+    let expected = match ctx.network.as_str() {
+        "mainnet" => "Mainnet",
+        "testnet" => "Testnet",
+        "testnet4" => "Testnet4",
+        "signet" => "Signet",
+        "regtest" => "Regtest",
+        _ => return Err(error("VSS_RESTORE_IDENTITY_MISMATCH")),
+    };
+    if value["version"] != 1 || value["bitcoin_network"] != expected {
+        return Err(error("VSS_RESTORE_IDENTITY_MISMATCH"));
+    }
+    if value["master_fingerprint"] != ctx.fp
+        || value["account_xpub_vanilla"] != ctx.vanilla
+        || value["account_xpub_colored"] != ctx.colored
+    {
+        return Err(error("VSS_RESTORE_IDENTITY_MISMATCH"));
+    }
+    // New-library snapshots keep BDK, RGB stock and proxy operation keys together in SQLite.
+    // Admit its complete public configuration, rather than accepting a manifest-shaped stub.
+    let schemas = value["supported_schemas"]
+        .as_array()
+        .ok_or_else(|| error("VSS_RESTORE_INVALID_MANIFEST"))?;
+    let mut known = HashSet::new();
+    if value["database_type"] != "Sqlite"
+        || !value["max_allocations_per_utxo"]
+            .as_u64()
+            .is_some_and(|n| n > 0 && n <= u32::MAX as u64)
+        || value["vanilla_keychain"] != 0
+        || value["witness_version"] != "Taproot"
+        || schemas.is_empty()
+        || schemas.iter().any(|schema| match schema.as_str() {
+            Some(name @ ("Nia" | "Uda" | "Cfa" | "Ifa" | "Bfa")) => !known.insert(name),
+            _ => true,
+        })
+    {
+        return Err(error("VSS_RESTORE_INVALID_MANIFEST"));
+    }
+    let identity = serde_json::json!([
+        value["version"],
+        value["bitcoin_network"],
+        value["master_fingerprint"],
+        value["account_xpub_vanilla"],
+        value["account_xpub_colored"],
+        value["vanilla_keychain"],
+        value["witness_version"],
+        value["database_type"],
+        value["max_allocations_per_utxo"],
+        value["supported_schemas"]
+    ]);
+    Ok(digest(identity.to_string().as_bytes()))
+}
+fn load_receipt(ctx: &Context) -> Result<Fields, APIError> {
+    let target = ctx.base.join(&ctx.fp);
+    let _dir = open_directory(&target)?;
+    let receipt: Receipt =
+        serde_json::from_slice(&private_read(&target.join(RECEIPT), MAX_RECEIPT)?)
+            .map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?;
+    let f = &receipt.fields;
+    if f.schema_version != 1
+        || f.version <= 0
+        || f.network != ctx.network
+        || f.node_id != ctx.node_id
+        || f.master_fingerprint != ctx.fp
+        || f.endpoint_sha256 != ctx.endpoint_hash
+        || f.target_sha256 != ctx.target_hash
+    {
+        return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+    }
+    let expected = mac(&read_key(ctx)?, f)?;
+    if receipt.mac.len() != expected.len()
+        || receipt
+            .mac
+            .bytes()
+            .zip(expected.bytes())
+            .fold(0u8, |n, (a, b)| n | (a ^ b))
+            != 0
+    {
+        return Err(error("VSS_RESTORE_INVALID_RECEIPT"));
+    }
+    let manifest = public_manifest_read(&target.join("wallet_manifest.json"))?;
+    if manifest.len() as u64 > MAX_MANIFEST
+        || manifest_identity(&manifest, ctx)? != f.manifest_identity_sha256
+    {
+        return Err(error("VSS_RESTORE_IDENTITY_MISMATCH"));
+    }
+    validate_local_database(&target.join(DATABASE_NAME))?;
+    Ok(receipt.fields)
+}
+
+fn validate_local_database(path: &Path) -> Result<(), APIError> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_NOFOLLOW);
+    let mut file = options
+        .open(path)
+        .map_err(|_| error("VSS_RESTORE_INVALID_DATABASE"))?;
+    let meta = file
+        .metadata()
+        .map_err(|_| error("VSS_RESTORE_INVALID_DATABASE"))?;
+    #[cfg(unix)]
+    if meta.uid() != unsafe { libc::geteuid() } || meta.mode() & 0o777 != 0o600 || meta.nlink() != 1
+    {
+        return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+    }
+    if !meta.is_file() || meta.len() < 100 || meta.len() > MAX_INFLATED {
+        return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+    }
+    let mut header = [0u8; 16];
+    file.read_exact(&mut header)
+        .map_err(|_| error("VSS_RESTORE_INVALID_DATABASE"))?;
+    if &header != SQLITE_HEADER {
+        return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+    }
+    Ok(())
+}
+
+fn archive_plan(bytes: &[u8], ctx: &Context) -> Result<String, APIError> {
+    if bytes.len() > MAX_COMPRESSED {
+        return Err(error("VSS_RESTORE_ARCHIVE_LIMIT"));
+    }
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes))
+        .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+    if archive.len() == 0 || archive.len() > MAX_ENTRIES {
+        return Err(error("VSS_RESTORE_ARCHIVE_LIMIT"));
+    }
+    let mut paths = HashSet::new();
+    let mut total = 0u64;
+    let mut manifest = None;
+    let mut database = false;
+    for i in 0..archive.len() {
+        let entry = archive
+            .by_index(i)
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+        let name = std::str::from_utf8(entry.name_raw())
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?
+            .to_owned();
+        let clean = name.trim_end_matches('/');
+        if name.ends_with("//")
+            || name.contains('\\')
+            || name.contains('\0')
+            || name.starts_with('/')
+            || clean
+                .split('/')
+                .any(|p| p.is_empty() || p == "." || p == "..")
+            || clean.split('/').next() != Some(ctx.fp.as_str())
+            || !paths.insert(clean.to_owned())
+            || entry.enclosed_name().is_none()
+        {
+            return Err(error("VSS_RESTORE_INVALID_ARCHIVE_PATH"));
+        }
+        if (clean == ctx.fp && !entry.is_dir()) || (entry.is_dir() && entry.size() != 0) {
+            return Err(error("VSS_RESTORE_INVALID_ARCHIVE_PATH"));
+        }
+        let mode = entry.unix_mode().unwrap_or(0) & 0o170000;
+        if ![0, 0o040000, 0o100000].contains(&mode)
+            || (entry.is_dir() && mode == 0o100000)
+            || (!entry.is_dir() && mode == 0o040000)
+        {
+            return Err(error("VSS_RESTORE_INVALID_ARCHIVE_PATH"));
+        }
+        if clean.split('/').any(|p| p == KEY)
+            || (clean.split('/').any(|p| p == RECEIPT) && clean != format!("{}/{RECEIPT}", ctx.fp))
+        {
+            return Err(error("VSS_RESTORE_INVALID_ARCHIVE_PATH"));
+        }
+        if clean.split('/').skip(1).any(|part| {
+            matches!(
+                part,
+                "rgb_lib_db-wal"
+                    | "rgb_lib_db-shm"
+                    | "rgb_lib_db-journal"
+                    | "bdk_db"
+                    | "bdk_db_watch_only"
+            )
+        }) {
+            return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+        }
+        total = total
+            .checked_add(entry.size())
+            .ok_or_else(|| error("VSS_RESTORE_ARCHIVE_LIMIT"))?;
+        if total > MAX_INFLATED
+            || entry.size() > entry.compressed_size().max(1).saturating_mul(2000)
+        {
+            return Err(error("VSS_RESTORE_ARCHIVE_LIMIT"));
+        }
+        if clean == format!("{}/wallet_manifest.json", ctx.fp) {
+            if entry.is_dir() || entry.size() > MAX_MANIFEST {
+                return Err(error("VSS_RESTORE_INVALID_MANIFEST"));
+            }
+            let mut data = Vec::new();
+            entry
+                .take(MAX_MANIFEST + 1)
+                .read_to_end(&mut data)
+                .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+            manifest = Some(manifest_identity(&data, ctx)?);
+        } else if clean == format!("{}/{DATABASE_NAME}", ctx.fp) {
+            if entry.is_dir() || entry.size() < 100 {
+                return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+            }
+            let mut header = [0u8; 16];
+            entry
+                .take(16)
+                .read_exact(&mut header)
+                .map_err(|_| error("VSS_RESTORE_INVALID_DATABASE"))?;
+            if &header != SQLITE_HEADER {
+                return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+            }
+            database = true;
+        } else if !entry.is_dir() && entry.size() >= 16 {
+            let mut header = [0u8; 16];
+            entry
+                .take(16)
+                .read_exact(&mut header)
+                .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+            if &header == SQLITE_HEADER {
+                return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+            }
+        }
+    }
+    if !database {
+        return Err(error("VSS_RESTORE_INVALID_DATABASE"));
+    }
+    manifest.ok_or_else(|| error("VSS_RESTORE_INVALID_MANIFEST"))
+}
+fn extract(bytes: &[u8], stage: &Path, ctx: &Context) -> Result<(), APIError> {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes))
+        .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+    let mut total = 0u64;
+    for i in 0..archive.len() {
+        let entry = archive
+            .by_index(i)
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+        let name = std::str::from_utf8(entry.name_raw())
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?
+            .trim_end_matches('/')
+            .to_owned();
+        if name == format!("{}/{RECEIPT}", ctx.fp) {
+            continue;
+        }
+        let target = stage.join(&name);
+        let directory = if entry.is_dir() {
+            &target
+        } else {
+            target
+                .parent()
+                .ok_or_else(|| error("VSS_RESTORE_INVALID_ARCHIVE_PATH"))?
+        };
+        fs::create_dir_all(directory).map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+        #[cfg(unix)]
+        {
+            for path in directory.ancestors().take_while(|p| *p != stage) {
+                fs::set_permissions(path, fs::Permissions::from_mode(0o700))
+                    .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+            }
+        }
+        if entry.is_dir() {
+            continue;
+        }
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+        let mut file = options
+            .open(&target)
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE_PATH"))?;
+        let declared = entry.size();
+        let count = std::io::copy(&mut entry.take(declared + 1), &mut file)
+            .map_err(|_| error("VSS_RESTORE_INVALID_ARCHIVE"))?;
+        total = total
+            .checked_add(count)
+            .ok_or_else(|| error("VSS_RESTORE_ARCHIVE_LIMIT"))?;
+        if count != declared || total > MAX_INFLATED {
+            return Err(error("VSS_RESTORE_ARCHIVE_LIMIT"));
+        }
+        file.sync_all()
+            .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    }
+    Ok(())
+}
+fn check_state(state: &AppState) -> Result<(), APIError> {
+    if state.cancel_token.is_cancelled() || *state.get_changing_state() {
+        return Err(error("VSS_RESTORE_NODE_UNAVAILABLE"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn prepare(state: Arc<AppState>) -> Result<String, APIError> {
+    check_state(&state)?;
+    let guard = state.get_unlocked_app_state().await;
+    check_state(&state)?;
+    if guard.is_some() {
+        return Err(error("VSS_RESTORE_REQUIRES_LOCKED"));
+    }
+    let ctx = Context::new(&state)?;
+    let base = open_directory(&ctx.base)?;
+    if fs::symlink_metadata(ctx.base.join(&ctx.fp)).is_ok() {
+        let receipt = load_receipt(&ctx)?;
+        return Ok(ctx.result(Some(receipt.version)).to_string());
+    }
+    for entry in fs::read_dir(&ctx.base).map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))? {
+        let entry = entry.map_err(|_| error("VSS_RESTORE_INVALID_TARGET"))?;
+        if entry.file_name().to_str().is_some_and(valid_fp) {
+            return Err(error("VSS_RESTORE_TARGET_CONFLICT"));
+        }
+    }
+    let client =
+        VssBackupClient::new(ctx.config()).map_err(|_| error("VSS_RESTORE_REMOTE_READ_FAILED"))?;
+    let before = client
+        .get_backup_version()
+        .await
+        .map_err(|_| error("VSS_RESTORE_REMOTE_READ_FAILED"))?;
+    let Some(version) = before else {
+        return Ok(ctx.result(None).to_string());
+    };
+    if version <= 0 {
+        return Err(error("VSS_RESTORE_INVALID_VERSION"));
+    }
+    // Public SDK transport may allocate this response before the local cap is checked.
+    let bytes = client
+        .download_backup()
+        .await
+        .map_err(|_| error("VSS_RESTORE_DOWNLOAD_FAILED"))?;
+    let manifest_hash = archive_plan(&bytes, &ctx)?;
+    let stage = tempfile::Builder::new()
+        .prefix(".vss-restore-")
+        .tempdir_in(&ctx.base)
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    extract(&bytes, stage.path(), &ctx)?;
+    validate_local_database(&stage.path().join(&ctx.fp).join(DATABASE_NAME))?;
+    let after = client
+        .get_backup_version()
+        .await
+        .map_err(|_| error("VSS_RESTORE_REMOTE_READ_FAILED"))?;
+    if after != Some(version) {
+        return Err(error("VSS_RESTORE_VERSION_CHANGED"));
+    }
+    check_state(&state)?;
+    let fields = Fields {
+        schema_version: 1,
+        network: ctx.network.clone(),
+        node_id: ctx.node_id.clone(),
+        master_fingerprint: ctx.fp.clone(),
+        version,
+        endpoint_sha256: ctx.endpoint_hash.clone(),
+        target_sha256: ctx.target_hash.clone(),
+        manifest_identity_sha256: manifest_hash,
+    };
+    let receipt = Receipt {
+        mac: mac(&receipt_key(&ctx, &base)?, &fields)?,
+        fields,
+    };
+    let restored = stage.path().join(&ctx.fp);
+    let restored_dir = open_directory(&restored)?;
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    let mut output = options
+        .open(restored.join(RECEIPT))
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    output
+        .write_all(&serde_json::to_vec(&receipt).map_err(|_| error("VSS_RESTORE_INVALID_RECEIPT"))?)
+        .and_then(|_| output.sync_all())
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    fs::write(restored.join(".vss_restored"), b"")
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    #[cfg(unix)]
+    fs::set_permissions(
+        restored.join(".vss_restored"),
+        fs::Permissions::from_mode(0o600),
+    )
+    .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    for entry in walkdir::WalkDir::new(&restored)
+        .follow_links(false)
+        .contents_first(true)
+    {
+        let entry = entry.map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+        if entry.file_type().is_symlink()
+            || !(entry.file_type().is_dir() || entry.file_type().is_file())
+        {
+            return Err(error("VSS_RESTORE_INVALID_ARCHIVE_PATH"));
+        }
+        File::open(entry.path())
+            .and_then(|file| file.sync_all())
+            .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    }
+    restored_dir
+        .sync_all()
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    let staging_dir = open_directory(stage.path())?;
+    check_state(&state)?;
+    #[cfg(unix)]
+    {
+        let actual =
+            fs::symlink_metadata(&ctx.base).map_err(|_| error("VSS_RESTORE_TARGET_CONFLICT"))?;
+        let original = base
+            .metadata()
+            .map_err(|_| error("VSS_RESTORE_TARGET_CONFLICT"))?;
+        if actual.file_type().is_symlink()
+            || actual.dev() != original.dev()
+            || actual.ino() != original.ino()
+        {
+            return Err(error("VSS_RESTORE_TARGET_CONFLICT"));
+        }
+    }
+    promote(&staging_dir, &ctx.fp, &base, &ctx.fp)?;
+    base.sync_all()
+        .map_err(|_| error("VSS_RESTORE_LOCAL_WRITE_FAILED"))?;
+    Ok(ctx.result(Some(version)).to_string())
+}
+
+pub(crate) async fn info(state: Arc<AppState>) -> Result<String, APIError> {
+    check_state(&state)?;
+    let guard = state.get_unlocked_app_state().await;
+    check_state(&state)?;
+    let ctx = Context::new(&state)?;
+    if !ctx.base.join(&ctx.fp).exists() || !ctx.base.join(&ctx.fp).join(RECEIPT).exists() {
+        return Ok("null".into());
+    }
+    let receipt = load_receipt(&ctx)?;
+    let mut result = ctx.result(Some(receipt.version));
+    result["unlocked"] = serde_json::json!(
+        guard.is_some() && !ctx.base.join(&ctx.fp).join(".vss_restored").exists()
+    );
+    Ok(result.to_string())
+}
