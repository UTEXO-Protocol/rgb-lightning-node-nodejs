 pub(crate) struct LdkBackgroundServices {
     stop_processing: Arc<AtomicBool>,
-    gossip_shutdown: Arc<tokio::sync::Notify>,
+    tasks: Arc<SessionTasks>,
+    completions: Arc<SessionTasks>,
     peer_manager: Arc<PeerManager>,
     bp_exit: Sender<()>,
     background_processor: Option<JoinHandle<Result<(), io::Error>>>,
 }
 
+impl Drop for LdkBackgroundServices {
+    fn drop(&mut self) {
+        self.stop_processing.store(true, Ordering::Release);
+        self.tasks.close();
+        self.completions.close();
+        self.peer_manager.disconnect_all_peers();
+        let _ = self.bp_exit.send(());
+        // Normal stop took and awaited this handle. Prevent accidental owner destruction
+        // from detaching a background processor which would retain the entire session.
+        if let Some(processor) = self.background_processor.take() {
+            processor.abort();
+        }
+    }
+}
