+        let k = MessageKey::from_seed(&[1; 32], Network::Regtest).unwrap();
+        let a = k.address.to_string();
+        for message in [
+            "",
+            "Hello World",
+            "  exact\n",
+            "NUL\0inside",
+            "Unicode:😄ö测试",
+            "e\u{301}",
+        ] {
+            let s = k.sign(message, &a).unwrap();
+            assert!(s.starts_with("smp"));
+            assert!(verify(message, &a, &s, Network::Regtest).unwrap());
+            assert!(verify(message, &a, &s[3..], Network::Regtest).unwrap());
+            assert!(!verify(&format!("{}!", message), &a, &s, Network::Regtest).unwrap());
+            assert!(!verify(message, &a, &format!("{}=", s), Network::Regtest).unwrap());
+            assert!(verify(message, &a, &s, Network::Bitcoin).is_err());
+            let mut bytes = STANDARD.decode(&s[3..]).unwrap();
+            bytes.push(0);
+            assert!(!verify(
+                message,
+                &a,
+                &format!("smp{}", STANDARD.encode(bytes)),
+                Network::Regtest
+            )
+            .unwrap());
+        }
+        let other = MessageKey::from_seed(&[2; 32], Network::Regtest).unwrap();
