@@ -58,3 +58,17 @@ lightning-rapid-gossip-sync = { path = "../../rust-lightning/lightning-rapid-gos
 lightning-transaction-sync = { path = "../../rust-lightning/lightning-transaction-sync" }
 vls-core = { git = "https://github.com/UTEXO-Protocol/vls-core.git", rev = "45c72edfd58620849eb486925439a76526b415ae" }
 vls-protocol-signer = { git = "https://github.com/UTEXO-Protocol/vls-protocol-signer.git", rev = "dddd336fcdf84c4febdd7af8363bda8d1721d893" }
+
+# The new RGB library owns its complete graph; do not reintroduce the retired s-bfa overrides.
+# This separate workspace must preserve the checked arithmetic required by that graph.
+[profile.release]
+overflow-checks = true
+
+# Rust 1.94's proc-macro stripping emits LINKEDIT string pools rejected by
+# macOS 27. These dependencies execute only during compilation, so this
+# override does not change the shipped target's optimization/strip policy.
+[profile.release.build-override]
+strip = "none"
+
+[profile.dev.build-override]
+strip = "none"
