diff --git a/bindings/c-ffi/build.rs b/bindings/c-ffi/build.rs
index f775f83..86daa71 100644
--- a/bindings/c-ffi/build.rs
+++ b/bindings/c-ffi/build.rs
@@ -3,6 +3,23 @@ extern crate cbindgen;
 use std::env;
 
 fn main() {
+    println!(
+        "cargo:rustc-env=RLN_BUILD_TARGET={}",
+        env::var("TARGET").unwrap()
+    );
+    for key in [
+        "RLN_ADAPTER_SHA256",
+        "RLN_WRAPPER_SHA256",
+        "RLN_LOCK_SHA256",
+    ] {
+        println!("cargo:rerun-if-env-changed={key}");
+        let value = env::var(key).expect("package build provenance is required");
+        assert!(
+            value.len() == 64 && value.bytes().all(|b| b.is_ascii_hexdigit()),
+            "invalid package build provenance"
+        );
+        println!("cargo:rustc-env={key}={value}");
+    }
     println!("cargo:rerun-if-changed=src");
     println!("cargo:rerun-if-changed=cbindgen.toml");
 
