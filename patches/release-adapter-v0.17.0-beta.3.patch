+/// Read the actual remote RGB snapshot status without uploading or clearing a fence.
+/// Raw automatic-backup errors stay private; only their presence crosses the binding.
+pub(crate) async fn vss_backup_info(state: Arc<AppState>) -> Result<String, APIError> {
+    let guard = check_unlocked(&state).await?;
+    let unlocked_state = guard.as_ref().unwrap().clone();
+    #[cfg(not(feature = "vss"))]
+    {
+        let _ = unlocked_state;
+        Err(APIError::Unexpected(
+            "VSS support is not compiled in".to_string(),
+        ))
+    }
+    #[cfg(feature = "vss")]
+    {
+        let vss_client = unlocked_state
+            .rgb_wallet_wrapper
+            .vss_client()
+            .ok_or_else(|| APIError::FailedVssInit("VSS is not configured".to_string()))?;
+        let wrapper = unlocked_state.rgb_wallet_wrapper.clone();
+        let info = tokio::task::spawn_blocking(move || wrapper.vss_backup_info(&vss_client))
+            .await
+            .map_err(|_| APIError::FailedVssInit("VSS backup status task failed".to_string()))?
+            .map_err(|_| {
+                APIError::FailedVssInit("VSS backup status could not be read".to_string())
+            })?;
+        Ok(serde_json::json!({
+            "backup_exists": info.backup_exists,
+            "version": info.server_version,
+            "backup_required": info.backup_required || unlocked_state.rgb_wallet_wrapper.snapshot_policy.as_ref().is_some_and(|p| p.pending()),
+            "last_auto_backup_failed": info.last_auto_backup_error.is_some() || unlocked_state.rgb_wallet_wrapper.snapshot_policy.as_ref().is_some_and(|p| p.failed.load(std::sync::atomic::Ordering::SeqCst))
+        }).to_string())
+    }
+}
