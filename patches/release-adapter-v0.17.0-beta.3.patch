+struct Bip322VerifyRequest {
+    message: String,
+    address: String,
+    signature: String,
+}
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Bip322VerifyOfflineRequest {
+    message: String,
+    address: String,
+    signature: String,
+    network: String,
+}
