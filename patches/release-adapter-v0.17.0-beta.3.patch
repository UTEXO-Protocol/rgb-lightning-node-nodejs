@@ -0,0 +1,699 @@
+//! Maintained snapshot policy and confirmed completion receipts. The public SDK
+//! transport remains available with its built-in scheduler disabled; our serialized
+//! mutation guard owns blocking automatic snapshots, so policy changes are barriers.
+use crate::{error::APIError, rgb_vss::VssBackupClient};
+use bitcoin::hashes::{sha256, Hash};
+use rgb_lib::{
+    wallet::{RgbWalletOpsOffline, Wallet},
+    BitcoinNetwork,
+};
+use serde::{Deserialize, Serialize};
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+use std::{
+    fs::{self, OpenOptions},
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+    time::{SystemTime, UNIX_EPOCH},
+};
+// Keep persisted upload times representable as exact JavaScript Date values.
+// Their validity must not depend on the device's subsequently corrected clock.
+const MAX_COMPLETION_TIME_MS: u64 = 8_640_000_000_000_000;
+fn error() -> APIError {
+    APIError::FailedVssInit("VSS snapshot policy could not be committed".into())
+}
+fn validate_completion_time_ms(value: u64) -> Result<u64, APIError> {
+    if (1..=MAX_COMPLETION_TIME_MS).contains(&value) {
+        Ok(value)
+    } else {
+        Err(error())
+    }
+}
+fn now_ms() -> Result<u64, APIError> {
+    u64::try_from(
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|_| error())?
+            .as_millis(),
+    )
+    .map_err(|_| error())
+    .and_then(validate_completion_time_ms)
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Completion {
+    pub version: i64,
+    pub completed_at_ms: u64,
+    pub network: String,
+    pub vss_url: String,
+    pub node_id: String,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PolicyFile {
+    schema_version: u32,
+    automatic_backup_enabled: bool,
+    network: String,
+    vss_url: String,
+    node_id: String,
+}
+pub(crate) struct SnapshotPolicy {
+    path: PathBuf,
+    network: String,
+    url: String,
+    node_id: String,
+    pub enabled: AtomicBool,
+    pub failed: AtomicBool,
+    unknown: AtomicBool,
+    unsaved: AtomicBool,
+}
+fn read_bounded(path: &Path) -> Result<Option<Vec<u8>>, APIError> {
+    let meta = match fs::symlink_metadata(path) {
+        Ok(v) => v,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(error()),
+    };
+    if !meta.is_file() || meta.len() > 4096 {
+        return Err(error());
+    }
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_NOFOLLOW);
+    let mut f = options.open(path).map_err(|_| error())?;
+    let mut bytes = Vec::new();
+    std::io::Read::by_ref(&mut f)
+        .take(4097)
+        .read_to_end(&mut bytes)
+        .map_err(|_| error())?;
+    if bytes.len() > 4096 {
+        return Err(error());
+    }
+    Ok(Some(bytes))
+}
+#[cfg(test)]
+thread_local! { static FAIL_AFTER_RENAME: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+fn sync_parent(path: &Path) -> Result<(), APIError> {
+    fs::File::open(path.parent().ok_or_else(error)?)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| error())
+}
+fn replace_once(path: &Path, bytes: &[u8], inject_fault: bool) -> (Result<(), APIError>, bool) {
+    let tmp = path.with_extension(format!("tmp-{}", rand::random::<u64>()));
+    let mut renamed = false;
+    let result = (|| {
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+        let mut file = options.open(&tmp).map_err(|_| error())?;
+        file.write_all(bytes).map_err(|_| error())?;
+        file.sync_all().map_err(|_| error())?;
+        if let Ok(meta) = fs::symlink_metadata(path) {
+            if !meta.is_file() {
+                return Err(error());
+            }
+        }
+        sync_parent(path)?;
+        fs::rename(&tmp, path).map_err(|_| error())?;
+        renamed = true;
+        #[cfg(test)]
+        if inject_fault && FAIL_AFTER_RENAME.with(|flag| flag.replace(false)) {
+            return Err(error());
+        }
+        #[cfg(not(test))]
+        let _ = inject_fault;
+        sync_parent(path)
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(tmp);
+    }
+    (result, renamed)
+}
+fn write_atomic(path: &Path, bytes: &[u8]) -> Result<(), APIError> {
+    let old = read_bounded(path)?;
+    let (result, renamed) = replace_once(path, bytes, true);
+    if result.is_err() && renamed {
+        // A failed durability barrier is not an acknowledgement. Restore the previous
+        // file before returning when possible. The policy setter independently reads
+        // back the actual choice if rollback itself encountered a filesystem failure.
+        let rollback = match old {
+            Some(previous) => replace_once(path, &previous, false).0,
+            None => fs::remove_file(path)
+                .map_err(|_| error())
+                .and_then(|_| sync_parent(path)),
+        };
+        if rollback.is_err() {
+            tracing::error!("VSS metadata write outcome is unknown after rollback failure");
+        }
+    }
+    result
+}
+fn confirmed_manifest_successor(before: i64, after: i64) -> Result<i64, APIError> {
+    if before.checked_add(1) == Some(after) && after > 0 {
+        Ok(after)
+    } else {
+        Err(error())
+    }
+}
+impl SnapshotPolicy {
+    pub(crate) fn load(
+        storage: &Path,
+        network: BitcoinNetwork,
+        url: String,
+        node_id: String,
+        initial: bool,
+    ) -> Result<Self, APIError> {
+        let network = network.to_string().to_lowercase();
+        let scope = format!("{network}\n{url}\n{node_id}");
+        let path = storage.join(format!(
+            ".utexo-vss-policy-v1-{}.json",
+            sha256::Hash::hash(scope.as_bytes())
+        ));
+        let enabled = if let Some(bytes) = read_bounded(&path)? {
+            let saved: PolicyFile = serde_json::from_slice(&bytes).map_err(|_| error())?;
+            if saved.schema_version != 1
+                || saved.network != network
+                || saved.vss_url != url
+                || saved.node_id != node_id
+            {
+                return Err(error());
+            }
+            saved.automatic_backup_enabled
+        } else {
+            initial
+        };
+        let policy = Self {
+            path,
+            network,
+            url,
+            node_id,
+            enabled: AtomicBool::new(enabled),
+            failed: AtomicBool::new(false),
+            unknown: AtomicBool::new(false),
+            unsaved: AtomicBool::new(false),
+        };
+        if !policy.path.exists() {
+            policy.commit_enabled(enabled)?;
+        }
+        Ok(policy)
+    }
+    fn completion_path(&self) -> PathBuf {
+        self.path.with_extension("completion.json")
+    }
+    pub(crate) fn pending(&self) -> bool {
+        self.unsaved.load(Ordering::SeqCst)
+            || match fs::symlink_metadata(self.path.with_extension("pending")) {
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => false,
+                _ => true,
+            }
+    }
+    pub(crate) fn before_mutation(&self) {
+        self.unsaved.store(true, Ordering::SeqCst);
+        if write_atomic(&self.path.with_extension("pending"), b"1").is_err() {
+            self.failed.store(true, Ordering::SeqCst);
+            tracing::error!("VSS unsaved-state marker could not be persisted");
+        }
+    }
+    pub(crate) fn clear_unchanged_intent(&self) -> Result<(), APIError> {
+        fs::remove_file(self.path.with_extension("pending")).map_err(|_| error())?;
+        sync_parent(&self.path)?;
+        self.unsaved.store(false, Ordering::SeqCst);
+        Ok(())
+    }
+    pub(crate) fn commit_enabled(&self, enabled: bool) -> Result<(), APIError> {
+        let saved = PolicyFile {
+            schema_version: 1,
+            automatic_backup_enabled: enabled,
+            network: self.network.clone(),
+            vss_url: self.url.clone(),
+            node_id: self.node_id.clone(),
+        };
+        if self.unknown.load(Ordering::SeqCst) {
+            return Err(error());
+        }
+        if let Err(failure) = write_atomic(
+            &self.path,
+            &serde_json::to_vec(&saved).map_err(|_| error())?,
+        ) {
+            let actual = read_bounded(&self.path)
+                .ok()
+                .flatten()
+                .and_then(|bytes| serde_json::from_slice::<PolicyFile>(&bytes).ok())
+                .filter(|value| {
+                    value.schema_version == 1
+                        && value.network == self.network
+                        && value.vss_url == self.url
+                        && value.node_id == self.node_id
+                });
+            if let Some(actual) = actual {
+                self.enabled
+                    .store(actual.automatic_backup_enabled, Ordering::SeqCst);
+            } else {
+                self.unknown.store(true, Ordering::SeqCst);
+                self.failed.store(true, Ordering::SeqCst);
+            }
+            return Err(failure);
+        }
+        self.enabled.store(enabled, Ordering::SeqCst);
+        Ok(())
+    }
+    /// The caller holds the RGB wallet mutex throughout preparation, upload and acknowledgement.
+    /// Taking an explicit client prevents this path from reacquiring the wrapper's wallet lock.
+    pub(crate) fn backup(
+        &self,
+        wallet: &mut Wallet,
+        client: &VssBackupClient,
+    ) -> Result<i64, APIError> {
+        self.unsaved.store(true, Ordering::SeqCst);
+        let result = (|| {
+            write_atomic(&self.path.with_extension("pending"), b"1")?;
+            if !client.encryption_enabled() {
+                return Err(error());
+            }
+            let snapshot = wallet.prepare_snapshot().map_err(|_| error())?;
+            let data = snapshot.data;
+            // Drive HTTP on the client's dedicated runtime without nesting Tokio block_on on
+            // a host runtime thread. Keep local mutation admission closed until readback/ack.
+            let upload = std::thread::scope(|scope| {
+                scope
+                    .spawn(|| {
+                        client.handle().block_on(async {
+                            let before = client
+                                .get_backup_version()
+                                .await
+                                .map_err(|_| error())?
+                                .unwrap_or(0);
+                            let version = client.upload_backup(data).await.map_err(|_| error())?;
+                            // This records actual acknowledged upload completion, not a later status read.
+                            let completed_at_ms = now_ms()?;
+                            let canonical = client
+                                .get_backup_version()
+                                .await
+                                .map_err(|_| error())?
+                                .ok_or_else(error)?;
+                            Ok::<_, APIError>((
+                                version,
+                                completed_at_ms,
+                                confirmed_manifest_successor(before, canonical)?,
+                            ))
+                        })
+                    })
+                    .join()
+            })
+            .map_err(|_| error())??;
+            let (version, completed_at_ms, canonical) = upload;
+            // A successful upload of stale content must never clear local dirty state.
+            if !wallet
+                .acknowledge_snapshot(&snapshot.token)
+                .map_err(|_| error())?
+            {
+                return Err(error());
+            }
+            let receipt = Completion {
+                version: canonical,
+                completed_at_ms,
+                network: self.network.clone(),
+                vss_url: self.url.clone(),
+                node_id: self.node_id.clone(),
+            };
+            write_atomic(
+                &self.completion_path(),
+                &serde_json::to_vec(&receipt).map_err(|_| error())?,
+            )?;
+            fs::remove_file(self.path.with_extension("pending")).map_err(|_| error())?;
+            sync_parent(&self.path)?;
+            self.unsaved.store(false, Ordering::SeqCst);
+            self.failed.store(false, Ordering::SeqCst);
+            Ok(version)
+        })();
+        if result.is_err() {
+            self.failed.store(true, Ordering::SeqCst);
+        }
+        result
+    }
+    pub(crate) fn after_mutation(&self, wallet: &mut Wallet, client: &VssBackupClient) {
+        if self.unknown.load(Ordering::SeqCst)
+            || !self.enabled.load(Ordering::SeqCst)
+            || std::thread::panicking()
+        {
+            return;
+        }
+        // Explicit mutation admission also covers stock, consignment and proxy-key changes.
+        if self.backup(wallet, client).is_err() {
+            self.failed.store(true, Ordering::SeqCst);
+            tracing::warn!("Automatic VSS snapshot failed; wallet operation result is preserved");
+        }
+    }
+    fn completion(&self) -> Result<Option<Completion>, APIError> {
+        if self.unknown.load(Ordering::SeqCst) {
+            return Err(error());
+        }
+        let receipt = match read_bounded(&self.completion_path())? {
+            None => None,
+            Some(bytes) => {
+                let r: Completion = serde_json::from_slice(&bytes).map_err(|_| error())?;
+                if r.version < 1
+                    || validate_completion_time_ms(r.completed_at_ms).is_err()
+                    || r.network != self.network
+                    || r.vss_url != self.url
+                    || r.node_id != self.node_id
+                {
+                    return Err(error());
+                }
+                Some(r)
+            }
+        };
+        Ok(receipt)
+    }
+    pub(crate) fn has_completed_backup(&self) -> Result<bool, APIError> {
+        Ok(self.completion()?.is_some())
+    }
+    pub(crate) fn metadata(&self) -> Result<String, APIError> {
+        let receipt = self.completion()?;
+        Ok(serde_json::json!({"schema_version":1,"automatic_backup_enabled":self.enabled.load(Ordering::SeqCst),"last_backup":receipt}).to_string())
+    }
+}
