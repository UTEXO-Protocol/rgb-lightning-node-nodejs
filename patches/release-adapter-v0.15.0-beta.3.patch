+#[cfg(test)]
+mod release_adapter_tests {
+    use super::*;
+
+    #[test]
+    fn tagged_assignment_is_exact_and_strict() {
+        for (input, expected) in [
+            ("Any", serde_json::json!({ "type": "Any" })),
+            ("NonFungible", serde_json::json!({ "type": "NonFungible" })),
+            (
+                "Fungible(0)",
+                serde_json::json!({ "type": "Fungible", "value": 0 }),
+            ),
+            (
+                "InflationRight(18446744073709551615)",
+                serde_json::json!({
+                    "type": "InflationRight", "value": u64::MAX
+                }),
+            ),
+        ] {
+            assert_eq!(
+                serde_json::to_value(parse_decoded_rgb_assignment(input).unwrap()).unwrap(),
+                expected
+            );
+        }
+        for input in [
+            "Unknown",
+            "Fungible(-1)",
+            "Fungible(+1)",
+            "Fungible( 1)",
+            "Fungible()",
+            "Fungible(18446744073709551616)",
+            "Fungible(1)x",
+        ] {
+            assert!(parse_decoded_rgb_assignment(input).is_err(), "{input}");
         }
     }
 }
