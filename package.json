{
  "name": "@utexo/rgb-lightning-node-nodejs",
  "version": "0.2.0-bfa.0",
  "description": "Node.js (napi-rs) bindings for rgb-lightning-node",
  "keywords": [
    "rgb",
    "lightning",
    "ldk",
    "bolt11",
    "utexo"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index-*.node",
    "index-*.provenance.json",
    "index.js",
    "index.d.ts",
    "json-boundary.js",
    "scripts/",
    "patches/",
    "src/",
    "build.rs",
    "Cargo.toml",
    "Cargo.lock",
    "README.md",
