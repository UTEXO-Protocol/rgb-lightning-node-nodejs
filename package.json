{
  "name": "@utexo/rgb-lightning-node-nodejs",
  "version": "0.2.0-bfa.1",
  "description": "Node.js (napi-rs) bindings for rgb-lightning-node",
  "keywords": [
    "rgb",
    "lightning",
    "ldk",
    "bolt11",
    "utexo"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index-*.node",
    "index-*.provenance.json",
    "index.js",
    "index.d.ts",
    "json-boundary.js",
    "scripts/",
    "patches/",
    "src/",
    "build.rs",
    "Cargo.toml",
    "Cargo.lock",
    "README.md",
    "UPGRADE-TRACKER.md",
    "RELEASE-0.15-TRACKER.md",
    "NATIVE-UPGRADE-20261012.md",
    "NATIVE-UPGRADE-20261014.md",
    "SIGNER-LIFECYCLE.md",
    "NATIVE-UPGRADE-20261015.md",
    "BIP322.md",
    "VSS-SAFETY.md",
    "BFA-MIGRATION.md"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/verify-release-artifacts.js",
    "postinstall": "node scripts/install-overlay-addon.js",
    "build": "node scripts/install-overlay-addon.js",
    "build:debug": "node scripts/install-overlay-addon.js --debug",
    "check:types": "tsc --noEmit --strict --skipLibCheck index.d.ts && tsc --noEmit --strict --target es2020 --module node16 scripts/burn-types.ts",
    "test:installer": "node --test scripts/install-overlay-addon.test.js",
    "test:unit": "node --test scripts/*.test.js",
    "test": "npm run test:unit && node test.js && node test-worker-teardown.js",
    "test:bip322:crypto": "node scripts/test-bip322-crypto.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
